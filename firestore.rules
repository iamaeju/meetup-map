rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 카카오 로그인은 Firebase Auth를 거치지 않아 uid 기반 소유자 검증이 불가능해서
    // users 컬렉션은 당분간 열어둠 (추후 Cloud Functions로 카카오 인증을 브릿지하면 잠글 예정)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    match /dmThreads/{threadId} {
      allow read: if true;
      allow write: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }
  }
}
